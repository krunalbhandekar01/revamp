# Copy to .env.local for local dev, or set these in the Vercel project settings.
# Both are read at BUILD time by Vite — changing them in Vercel requires a redeploy,
# not just a restart.

# Keep the dummy-data layer on. Set to "false" only once src/api/* actually calls the server.
VITE_USE_MOCKS=true

# Backend origin. Ignored entirely while VITE_USE_MOCKS is true.
VITE_API_URL=https://api.buyofuel.com
